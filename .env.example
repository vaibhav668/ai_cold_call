# Application Configuration
APP_NAME="AI Voice Calling Platform"
APP_ENV=development  # development, staging, production
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
# For local docker-compose, use the defaults
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ai_cold_call"

# ChromaDB Configuration
VECTOR_DB_PROVIDER="chroma"
CHROMA_DB_PATH="./data/chroma"

# Plivo Telephony Configuration
TELEPHONY_PROVIDER="plivo"
PLIVO_AUTH_ID=""
PLIVO_AUTH_TOKEN=""
PLIVO_PHONE_NUMBER=""

# AI LLM Provider settings
OPENAI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
LLM_PROVIDER="qwen"
FALLBACK_LLM_PROVIDER="openrouter"
LLM_MODEL="qwen3-instruct"

# Speech AI subsystem config
STT_PROVIDER="faster_whisper"
WHISPER_MODEL="large-v3-turbo"
VAD_PROVIDER="silero"
TTS_PROVIDER="kokoro"

# Local testing defaults
LOW_MEMORY_DEPLOYMENT="false"
KOKORO_MODEL_DIR="./models/kokoro"

